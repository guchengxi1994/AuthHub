# Docker Compose defaults for local development only.
AUTH_HUB_PORT=8000
AUTH_HUB_ADMIN_USERNAME=admin
# Use a unique password. Docker Compose refuses to start without it.
AUTH_HUB_ADMIN_PASSWORD=replace-with-a-strong-local-password
AUTH_HUB_MODULE_REGISTRATION_KEY=replace-with-a-service-registration-key
